    /* Explorador de archivos (derecha): una carpeta abierta como árbol, al estilo del de VS Code */
    .qc-explorer { flex-direction: column; position: sticky; top: .5rem; min-width: 0; min-height: 260px; max-height: calc(100vh - 110px);
