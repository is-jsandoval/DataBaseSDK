    .qc-detail { flex: 1 1 0; min-width: 0; color: #888; font-size: .85em; overflow: hidden; text-overflow: ellipsis; }
    .qc-actions { margin-left: auto; display: none; gap: 4px; }
    .qc-row:hover .qc-actions { display: inline-flex; }
    .qc-children { margin-left: 12px; padding-left: 4px; border-left: 1px dotted rgba(127,127,127,.4); }
    .qc-definition { max-height: 30vh; overflow: auto; white-space: pre; font-family: Consolas, "Courier New", monospace; font-size: .8rem; }
</style>
