        background: var(--db-surface-2, #2d2d30); color: var(--db-text, #e1e1e1); border-bottom: 1px solid var(--db-border, #3c3c3c); }
    .qc-results tbody tr:nth-child(even) > td { background-color: rgba(127,127,127,.12); }
    .qc-cell { max-width: 420px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Edición en la grilla */
    .qc-edit-bar { display: flex; align-items: center; gap: 8px; padding: 4px 8px; margin-bottom: 4px; border-radius: .375rem;
