    /* Árbol */
    .qc-row { display: flex; align-items: center; gap: 4px; padding: 1px 2px; border-radius: 3px; cursor: pointer; white-space: nowrap; }
    .qc-row:hover { background: rgba(127,127,127,.2); }
    .qc-row.qc-selected { background: rgba(13,110,253,.25); }
    .qc-caret { display: inline-block; width: 12px; text-align: center; color: #888; flex: 0 0 12px; }
