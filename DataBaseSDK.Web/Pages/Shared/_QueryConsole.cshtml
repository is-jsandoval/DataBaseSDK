        border-radius: .5rem; box-shadow: 0 12px 34px rgba(0,0,0,.65); font-size: .9rem; }
    .qc-switcher-title { padding: 6px 12px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; font-weight: 600;
        color: var(--db-text-muted, #9d9d9d); border-bottom: 1px solid var(--db-border, #3c3c3c); }
    .qc-switcher-list { max-height: 50vh; overflow: auto; padding: 4px; }
