    .qx-actions button:hover, .qx-folder-close:hover { background: rgba(127,127,127,.25); color: var(--db-text, #e1e1e1); }
    .qx-folder { display: flex; align-items: center; justify-content: space-between; padding: 3px 6px 3px 10px; background: var(--db-surface-2, #2d2d30); font-size: .75rem; font-weight: 700; text-transform: uppercase; }
    .qx-folder[hidden] { display: none; }
    .qx-folder-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .qx-body { flex: 1 1 auto; overflow: auto; padding: 2px 0 8px; font-size: .85rem; outline: none; }
    .qx-body:focus-visible { box-shadow: inset 0 0 0 1px var(--db-link, #4fc1ff); }
    .qx-row { display: flex; align-items: center; gap: 4px; padding-right: 8px; height: 22px; cursor: pointer; white-space: nowrap; border-left: 2px solid transparent; }
    .qx-row:hover { background: rgba(127,127,127,.2); }
    .qx-row.qx-selected { background: rgba(13,110,253,.28); }
    .qx-row.qx-active { background: rgba(79,193,255,.16); border-left-color: var(--db-link, #4fc1ff); }
    .qx-row.qx-active.qx-selected { background: rgba(13,110,253,.4); }
    .qx-twisty { flex: 0 0 12px; text-align: center; color: var(--db-text-muted, #9d9d9d); font-size: .7rem; }
    .qx-icon { flex: 0 0 auto; }
    .qx-label { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    .qx-file-row.qx-opened .qx-label { color: var(--db-link, #4fc1ff); }
    .qx-dot { flex: 0 0 auto; color: #e2a03f; font-size: .7rem; }
    .qx-hint { padding: 3px 10px; color: var(--db-text-muted, #9d9d9d); font-size: .8rem; white-space: normal; }
    .qx-empty { padding: 10px; }
    .qx-empty .qx-recent { display: block; width: 100%; text-align: left; border: 0; background: transparent; color: var(--db-text, #e1e1e1); padding: 2px 4px; border-radius: 3px; cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .qx-empty .qx-recent:hover { background: rgba(127,127,127,.25); }
    .qx-empty .qx-recent small { color: var(--db-text-muted, #9d9d9d); margin-left: 6px; }

    /* Ctrl+Tab: lista "Archivos activos" en orden de uso reciente (aparece si se mantiene Ctrl un instante) */
    .qc-switcher { position: fixed; z-index: 2600; top: 20%; left: 50%; transform: translateX(-50%); min-width: 340px; max-width: min(620px, 92vw);
