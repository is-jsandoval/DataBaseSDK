    .qc-cell-editor { display: flex; gap: 2px; align-items: center; min-width: 160px; }
    .qc-cell-editor input { flex: 1 1 auto; min-width: 0; font-size: inherit; padding: 1px 4px; border: 1px solid #4fc1ff; border-radius: 2px;
        background: var(--db-surface, #252526); color: var(--db-text, #e1e1e1); }
    .qc-cell-editor button { font-size: .75rem; padding: 0 5px; line-height: 1.5; }
