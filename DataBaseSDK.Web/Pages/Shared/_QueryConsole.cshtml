        border: 1px solid var(--db-border, #3c3c3c); border-bottom: 0; border-radius: .375rem .375rem 0 0; background: var(--db-surface, #252526); color: var(--db-text-muted, #9d9d9d); }
    .qc-tab:hover { color: var(--db-text, #e1e1e1); }
    .qc-tab-active { background: var(--db-surface-2, #2d2d30); color: var(--db-text, #e1e1e1); border-top: 2px solid #4fc1ff; }
