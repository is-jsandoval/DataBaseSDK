# DataBaseSDK - copia este archivo como .env (el .env no se sube a git). TODO es opcional.
# Las conexiones tambien se pueden agregar desde la propia pantalla ("+ Conexion"): se guardan en
# .local\db-connections.json con la contrasena cifrada con tu usuario de Windows (DPAPI).

# Conexiones por variable: una por base de datos; el sufijo es el nombre que ves en la lista. Aparecen como
# solo lectura (con la etiqueta .env) y contienen la clave de la base: usa un usuario de solo lectura.
#SQLSERVER_CONN_DEV=Server=host,1433;Database=base;User Id=usuario;Password=clave;TrustServerCertificate=True
#SQLSERVER_CONN_LOCAL=Server=localhost;Database=base;Integrated Security=True;TrustServerCertificate=True
#ORACLE_CONN_DEV=Data Source=host:1521/SERVICIO;User Id=usuario;Password=clave
# Con un alias de tnsnames.ora (Data Source=ALIAS) define ademas TNS_ADMIN apuntando a su carpeta:
#TNS_ADMIN=C:\oracle\network\admin

# Edicion de filas desde la grilla de resultados: APAGADA por defecto. Lista de alias de las conexiones de arriba que
# la permiten (coma o punto y coma; * = todas). Las conexiones guardadas desde la pantalla la activan con su propia
# casilla. Necesita un usuario con permiso de escritura: NO la habilites sobre produccion.
#DBSDK_WRITE=DEV

# Puerto del sitio (solo escucha en localhost, no hay opcion para abrirlo a la red). Por defecto 5130.
#DBSDK_PORT=5130

# Archivo de las conexiones guardadas desde la pantalla (por defecto .local\db-connections.json).
#DBSDK_CONNECTIONS_FILE=

# La primera vez, si aun no hay archivo propio, se importan las conexiones de ..\AzureDevOpsSdk\.local\db-connections.json
# (el proyecto del que nacio este) SIN el permiso de edicion. Aqui puedes indicar otro origen, o "none" para no importar.
#DBSDK_IMPORT_CONNECTIONS_FROM=none
